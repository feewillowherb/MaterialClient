<Window x:Class="FdSoft.Material.WpfClient.Order.Index"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FdSoft.Material.WpfClient.Order"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
        mc:Ignorable="d"
        Title="台账管理" Height="600" Width="1100" Icon="/Resources/fd-ico.ico" >
    <Grid>
        <DockPanel Margin="0">
            <DockPanel Height="50" LastChildFill="False" VerticalAlignment="Top" DockPanel.Dock="Top">
                <Grid Margin="0,10,0,0" DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="txt_GetTruckNo" Margin="5" Width="100" Height="30" VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <VisualBrush x:Key="HelpBrush" TileMode="None" Opacity="0.3" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock FontStyle="Italic" Text="车牌号码"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Background" Value="{StaticResource HelpBrush}"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource HelpBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox x:Name="txt_GetOrderNo" Margin="5" Width="100" Height="30" VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <VisualBrush x:Key="HelpBrush" TileMode="None" Opacity="0.3" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock FontStyle="Italic" Text="发货单号"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Background" Value="{StaticResource HelpBrush}"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource HelpBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox x:Name="txt_GetGoodsName" Margin="5" Width="100" Height="30" VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <VisualBrush x:Key="HelpBrush" TileMode="None" Opacity="0.3" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock FontStyle="Italic" Text="商品名称"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Background" Value="{StaticResource HelpBrush}"/>
                                        </Trigger>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource HelpBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <ComboBox x:Name="cb_Head_OrderType" IsReadOnly="True" Margin="5" Width="100" Height="30">
                            <ComboBoxItem Content="状态(全部)" IsSelected="True"></ComboBoxItem>
                            <ComboBoxItem Content="收货中" Tag="0"></ComboBoxItem>
                            <ComboBoxItem Content="已收货" Tag="1"></ComboBoxItem>
                            <ComboBoxItem Content="已取消" Tag="2"></ComboBoxItem>
                        </ComboBox>
                        <!--<ComboBox Height="30" VerticalAlignment="Top" Margin="449,0,527,0" VerticalContentAlignment="Center" IsReadOnly="True">
                                        <ComboBoxItem Content="收货方式(全部)" IsSelected="True"></ComboBoxItem>
                                        <ComboBoxItem Content="普通收货"></ComboBoxItem>
                                        <ComboBoxItem Content="发货单收货"></ComboBoxItem>
                                    </ComboBox>-->
                        <Label Content="进场日期：" Margin="5" Width="60" Height="30"/>
                        <DatePicker x:Name="dp_Head_JoinDateStart" Text="进场日期" Margin="5" Width="100" Height="30">
                            <DatePicker.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </DatePicker.RenderTransform>
                        </DatePicker>
                        <Label Content="-" Margin="5" Width="15" Height="30"/>
                        <DatePicker x:Name="dp_Head_JoinDateEnd" Margin="5" Width="100" Height="30">
                            <DatePicker.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </DatePicker.RenderTransform>
                        </DatePicker>
                    </StackPanel>
                    <Grid HorizontalAlignment="Right">
                        <Button Click="Btn_Head_QueryShouLiao_Click" Content="查询" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Top" Width="75"/>
                    </Grid>
                </Grid>
            </DockPanel>
            <DockPanel LastChildFill="False"  VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Height="50">
                <Grid DockPanel.Dock="Top">
                    <Grid HorizontalAlignment="Left">
                        <Button Click="Btn_Page_FirstClick" Content="首页" Width="75" Margin="10,10,0,0" Padding="16,4" HorizontalAlignment="Left"/>
                        <Button Click="Btn_Page_PrevClick" Content="上一页" VerticalAlignment="Top" Width="75" Margin="102,10,0,0" HorizontalAlignment="Left"/>
                        <Button Click="Btn_Page_NextClick" Content="下一页" VerticalAlignment="Top" Width="75" Margin="193,10,792,0"/>
                        <Button Click="Btn_Page_LastClick" Content="末页" VerticalAlignment="Top" Width="75" Margin="285,10,700,0"/>
                        <Label Content="跳转到" Margin="385,15,633,0" VerticalAlignment="Top"/>
                        <TextBox x:Name="txt_Page_To" TextWrapping="Wrap" Text="1" Margin="427,13,607,4" HorizontalContentAlignment="Center" />
                        <Label Content="页" Margin="458,15,581,0" VerticalAlignment="Top"/>
                        <Button Click="Btn_Page_GoClick" Content="确定" Margin="485,10,500,0" VerticalAlignment="Top" Width="75"/>
                    </Grid>
                    <Grid HorizontalAlignment="Right">
                        <Label Content="现页数：" Margin="131,15,263,0" VerticalAlignment="Top" RenderTransformOrigin="-0.071,0.522"/>
                        <Label x:Name="lbl_Page_NowCount" Content="1" Margin="181,15,230,0" VerticalAlignment="Top" RenderTransformOrigin="-0.071,0.522"/>
                        <Label Content="总条数：" Margin="233,15,148,0" VerticalAlignment="Top" RenderTransformOrigin="-0.071,0.522"/>
                        <Label x:Name="lbl_Page_TotalCount" Content="0" Margin="283,15,106,0" VerticalAlignment="Top" RenderTransformOrigin="-0.071,0.522"/>
                        <Label Content="总页数：" Margin="338,15,50,0" VerticalAlignment="Top" RenderTransformOrigin="-0.071,0.522"/>
                        <Label x:Name="lbl_Page_PageCount" Content="0" Margin="386,15,10,0" VerticalAlignment="Top" RenderTransformOrigin="-0.071,0.522"/>
                    </Grid>
                    <materialDesign:Snackbar
                                        x:Name="SnackbarSeven"
                                        MessageQueue="{materialDesign:MessageQueue}" 
                                        VerticalAlignment="Center" Background="#FF2196F3" Panel.ZIndex="10" Margin="0, -600, 0,0"/>
                </Grid>
            </DockPanel>
            <DockPanel LastChildFill="False" VerticalAlignment="Top" DockPanel.Dock="Top"/>
            <DataGrid x:Name="dg_Data_List1" MinWidth="1077" ItemsSource="{Binding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Visible" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn  Binding="{Binding OrderNo}" ClipboardContentBinding="{x:Null}" Header="运单号"/>
                    <DataGridTextColumn  Binding="{Binding TruckNo}" ClipboardContentBinding="{x:Null}" Header="车牌号"/>
                    <DataGridTextColumn  Binding="{Binding TypeName}" ClipboardContentBinding="{x:Null}" Header="类型"/>
                    <DataGridTextColumn  Binding="{Binding GoodsNameSize}" ClipboardContentBinding="{x:Null}" Header="商品"/>
                    <DataGridTextColumn  Binding="{Binding OrderTypeName}" ClipboardContentBinding="{x:Null}" Header="状态"/>
                    <DataGridTextColumn  Binding="{Binding GoodsPlanOnPcsDesc}" ClipboardContentBinding="{x:Null}" Header="运单数量"/>
                    <DataGridTextColumn  Binding="{Binding GoodsPlanOnWeightDesc}" ClipboardContentBinding="{x:Null}" Header="运单重量"/>
                    <DataGridTextColumn  Binding="{Binding GoodsTakeWeightDesc}" ClipboardContentBinding="{x:Null}" Header="扣量"/>
                    <DataGridTextColumn  Binding="{Binding GoodsPcsDesc}" ClipboardContentBinding="{x:Null}" Header="实际数量"/>
                    <DataGridTextColumn  Binding="{Binding GoodsWeightDesc}" ClipboardContentBinding="{x:Null}" Header="实际重量"/>
                    <!--<DataGridTextColumn  Binding="{Binding ProviderId}" ClipboardContentBinding="{x:Null}" Header="偏差(%)"/>-->
                    <!--<DataGridTextColumn  Binding="{Binding UpperLowerLimit}" ClipboardContentBinding="{x:Null}" Header="偏差阈值"/>-->
                    <DataGridTextColumn  Binding="{Binding UnitNameRate}" ClipboardContentBinding="{x:Null}" Header="单位换算"/>
                    <!--<DataGridTextColumn  Binding="{Binding ProviderId}" ClipboardContentBinding="{x:Null}" Header="收货方式"/>-->
                    <DataGridTextColumn  Binding="{Binding JoinTime}" ClipboardContentBinding="{x:Null}" Header="进场时间"/>
                    <DataGridTextColumn  Binding="{Binding OutTime}" ClipboardContentBinding="{x:Null}" Header="出场时间"/>
                    <DataGridTextColumn  Binding="{Binding ProviderName}" ClipboardContentBinding="{x:Null}" Header="供应商"/>
                    <DataGridTextColumn  Binding="{Binding DispatchNo}" ClipboardContentBinding="{x:Null}" Header="发货单号"/>
                    <DataGridTextColumn  Binding="{Binding Remark}" ClipboardContentBinding="{x:Null}" Header="备注"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
