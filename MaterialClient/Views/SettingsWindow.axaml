<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MaterialClient.ViewModels"
        xmlns:converters="using:MaterialClient.Converters"
        x:Class="MaterialClient.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="系统设置"
        Width="940" Height="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/fd-ico.ico"
        CanResize="False">
    
    <Window.Styles>
        <!-- Navigation ListBox Styles -->
        <Style Selector="ListBox.settings-nav">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style Selector="ListBox.settings-nav > ListBoxItem">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        
        <Style Selector="ListBox.settings-nav > ListBoxItem:pointerover">
            <Setter Property="Background" Value="#E8E8E8"/>
        </Style>
        
        <Style Selector="ListBox.settings-nav > ListBoxItem:selected">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#6398FF"/>
            <Setter Property="BorderBrush" Value="#6398FF"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>
        
        <!-- Section Header Style -->
        <Style Selector="Border.section-header">
            <Setter Property="BorderBrush" Value="#E6E6E6"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Margin" Value="0,20,0,16"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="50,*" ColumnDefinitions="160,*">
        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                Background="#6498FE" 
                HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*,Auto" Margin="15,0">
                <TextBlock Text="系统设置"
                           FontSize="14"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Grid.Column="0" />
                <Button Content="×"
                        FontSize="24"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="35" Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Grid.Column="1"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <!-- Left Navigation Panel -->
        <ListBox x:Name="NavigationList"
                 Grid.Row="1" 
                 Grid.Column="0"
                 Classes="settings-nav"
                 SelectionChanged="OnNavigationSelectionChanged"
                 BorderThickness="1,0,1,1"
                 BorderBrush="LightGray">
            <ListBoxItem Tag="ScaleSettings" x:Name="ScaleSettingsNavItem">地磅设置</ListBoxItem>
            <ListBoxItem Tag="WeighingSettings" x:Name="WeighingSettingsNavItem">称重设置</ListBoxItem>
            <ListBoxItem Tag="CameraSettings" x:Name="CameraSettingsNavItem">摄像头设置</ListBoxItem>
            <ListBoxItem Tag="LprSettings" x:Name="LprSettingsNavItem">车牌识别设置</ListBoxItem>
            <ListBoxItem Tag="SystemSettings" x:Name="SystemSettingsNavItem">系统设置</ListBoxItem>
            <ListBoxItem Tag="SoundSettings" x:Name="SoundSettingsNavItem">音响设备设置</ListBoxItem>
            <ListBoxItem Tag="PrinterSettings" x:Name="PrinterSettingsNavItem">打印机设置</ListBoxItem>
        </ListBox>

        <!-- Right Content Panel -->
        <Border Grid.Row="1" Grid.Column="1" 
                BorderBrush="LightGray" 
                BorderThickness="0,0,1,1">
            <ScrollViewer x:Name="ContentScrollViewer"
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Hidden">
                <StackPanel Spacing="0" Margin="0">
                    <!-- Scale Settings Group -->
                    <Border x:Name="ScaleSettings" 
                            Classes="section-header"
                            Padding="0,0,0,0">
                        <TextBlock Text="地磅设置"
                                   FontSize="14"
                                   Background="White"
                                   Foreground="Black"
                                   Margin="10,0,0,-15"
                                   Width="80"
                                   TextAlignment="Center" />
                    </Border>
                    <Border Padding="20" Margin="0,0,0,0">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12"
                                  ColumnSpacing="12">
                            <TextBlock Text="串口:"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       Width="120" />
                            <ComboBox ItemsSource="{Binding AvailableSerialPorts}"
                                      SelectedItem="{Binding ScaleSerialPort}"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      PlaceholderText="请选择串口" />

                            <TextBlock Text="波特率:"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       Width="120" />
                            <TextBox Text="{Binding ScaleBaudRate}"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Watermark="9600" />

                            <TextBlock Text="通讯方式:"
                                       Grid.Row="2"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       Width="120" />
                            <TextBox Text="{Binding ScaleCommunicationMethod}"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Watermark="TF0" />

                            <TextBlock Text="地磅单位:"
                                       Grid.Row="3"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       Width="120" />
                            <ComboBox ItemsSource="{Binding ScaleUnitOptions}"
                                      SelectedItem="{Binding ScaleUnit}"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., Converter={StaticResource ScaleUnitConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="地磅类型:"
                                       Grid.Row="4"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       Width="120" />
                            <ComboBox ItemsSource="{Binding ScaleTypeOptions}"
                                      SelectedItem="{Binding ScaleType}"
                                      Grid.Row="4"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., Converter={StaticResource ScaleTypeConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Weighing Settings Group -->
                    <Border x:Name="WeighingSettings" 
                            Classes="section-header"
                            Padding="0,0,0,0">
                        <TextBlock Text="称重设置"
                                   FontSize="14"
                                   Background="White"
                                   Foreground="Black"
                                   Margin="10,0,0,-15"
                                   Width="80"
                                   TextAlignment="Center" />
                    </Border>
                    <Border Padding="20" Margin="0,0,0,0">
                        <StackPanel Spacing="12">

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12"
                              ColumnSpacing="12">
                            <TextBlock Text="最小称重阈值(吨):"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="160" />
                            <TextBox Text="{Binding MinWeightThreshold}"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Watermark="0.5" />

                            <TextBlock Text="重量稳定性阈值(吨):"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="160" />
                            <TextBox Text="{Binding WeightStabilityThreshold}"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Watermark="0.05" />

                            <TextBlock Text="稳定性窗口时间(毫秒):"
                                       Grid.Row="2"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="160" />
                            <TextBox Text="{Binding StabilityWindowMs}"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Watermark="3000" />

                            <TextBlock Text="稳定性检查间隔(毫秒):"
                                       Grid.Row="3"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="160" />
                            <TextBox Text="{Binding StabilityCheckIntervalMs}"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Watermark="200" />

                            <TextBlock Text="匹配最大时间间隔(分钟):"
                                       Grid.Row="4"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="160" />
                            <TextBox Text="{Binding MaxIntervalMinutes}"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     Watermark="300" />

                            <TextBlock Text="匹配最小重量差(吨):"
                                       Grid.Row="5"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="160" />
                            <TextBox Text="{Binding MinWeightDiff}"
                                     Grid.Row="5"
                                     Grid.Column="1"
                                     Watermark="1" />
                        </Grid>
                    </StackPanel>
                    </Border>

                    <!-- Camera Settings Group -->
                    <Border x:Name="CameraSettings" 
                            Classes="section-header"
                            Padding="0,0,0,0">
                        <TextBlock Text="摄像头设置"
                                   FontSize="14"
                                   Background="White"
                                   Foreground="Black"
                                   Margin="10,0,0,-15"
                                   Width="80"
                                   TextAlignment="Center" />
                    </Border>
                    <Border Padding="20" Margin="0,0,0,0">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Content="增加摄像头"
                                        Command="{Binding AddCameraCommand}"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        Foreground="#2196F3"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="20,10,0,10"
                                        HorizontalAlignment="Left" />
                            </Grid>
                            
                            <!-- Camera List Display -->
                            <Grid ColumnDefinitions="107,107,107,107,107,107,Auto" 
                                  Margin="0,0,0,0">
                                <!-- Table Header -->
                                <Border Grid.Column="0" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="名称"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                                <Border Grid.Column="1" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="IP"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                                <Border Grid.Column="2" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="端口"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                                <Border Grid.Column="3" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="通道号"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                                <Border Grid.Column="4" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="用户名"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                                <Border Grid.Column="5" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="密码"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                                <Border Grid.Column="6" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="操作"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                            </Grid>

                            <ListBox ItemsSource="{Binding CameraConfigs}" 
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Margin="0,0,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CameraConfigViewModel">
                                        <Grid ColumnDefinitions="107,107,107,107,107,107,Auto" 
                                              Margin="0,0,0,0"
                                              Height="35">
                                            <Border Grid.Column="0" 
                                                    BorderBrush="#E6E6E6" 
                                                    BorderThickness="1"
                                                    Height="35"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Width="107">
                                                <TextBlock Text="{Binding Name}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" />
                                            </Border>
                                            <Border Grid.Column="1" 
                                                    BorderBrush="#E6E6E6" 
                                                    BorderThickness="1"
                                                    Height="35"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Width="107">
                                                <TextBlock Text="{Binding Ip}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" />
                                            </Border>
                                            <Border Grid.Column="2" 
                                                    BorderBrush="#E6E6E6" 
                                                    BorderThickness="1"
                                                    Height="35"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Width="107">
                                                <TextBlock Text="{Binding Port}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" />
                                            </Border>
                                            <Border Grid.Column="3" 
                                                    BorderBrush="#E6E6E6" 
                                                    BorderThickness="1"
                                                    Height="35"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Width="107">
                                                <TextBlock Text="{Binding Channel}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" />
                                            </Border>
                                            <Border Grid.Column="4" 
                                                    BorderBrush="#E6E6E6" 
                                                    BorderThickness="1"
                                                    Height="35"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Width="107">
                                                <TextBlock Text="{Binding UserName}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" />
                                            </Border>
                                            <Border Grid.Column="5" 
                                                    BorderBrush="#E6E6E6" 
                                                    BorderThickness="1"
                                                    Height="35"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Width="107">
                                                <TextBlock Text="****"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" />
                                            </Border>
                                            <Button Grid.Column="6"
                                                    Content="删除"
                                                    Command="{Binding $parent[ListBox].((vm:SettingsWindowViewModel)DataContext).RemoveCameraCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    Foreground="Red"
                                                    BorderThickness="0"
                                                    Width="107"
                                                    Height="35"
                                                    Margin="0,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- License Plate Recognition Settings Group -->
                    <Border x:Name="LprSettings" 
                            Classes="section-header"
                            Padding="0,0,0,0">
                        <TextBlock Text="车牌识别设置"
                                   FontSize="14"
                                   Background="White"
                                   Foreground="Black"
                                   Margin="10,0,0,-15"
                                   Width="80"
                                   TextAlignment="Center" />
                    </Border>
                    <Border Padding="20" Margin="0,0,0,0">
                        <StackPanel Spacing="12">
                            <Button Content="增加抓拍机"
                                    Command="{Binding AddLicensePlateRecognitionCommand}"
                                    Background="Transparent"
                                    Foreground="#2196F3"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="20,10,0,10"
                                    HorizontalAlignment="Left" />
                            
                            <!-- LPR List Display -->
                            <Grid ColumnDefinitions="107,107,107,Auto" 
                                  Margin="0,0,0,0">
                                <!-- Table Header -->
                                <Border Grid.Column="0" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="设备名称"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                                <Border Grid.Column="1" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="设备IP"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                                <Border Grid.Column="2" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="进出方向"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                                <Border Grid.Column="3" 
                                        BorderBrush="#E6E6E6" 
                                        BorderThickness="1"
                                        Height="35"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Width="107"
                                        Background="#E6E6E6">
                                    <TextBlock Text="操作"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="Black" />
                                </Border>
                            </Grid>

                            <ListBox ItemsSource="{Binding LicensePlateRecognitionConfigs}" 
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Margin="0,0,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LicensePlateRecognitionConfigViewModel">
                                        <Grid ColumnDefinitions="107,107,107,Auto" 
                                              Margin="0,0,0,0"
                                              Height="35">
                                            <Border Grid.Column="0" 
                                                    BorderBrush="#E6E6E6" 
                                                    BorderThickness="1"
                                                    Height="35"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Width="107">
                                                <TextBlock Text="{Binding Name}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" />
                                            </Border>
                                            <Border Grid.Column="1" 
                                                    BorderBrush="#E6E6E6" 
                                                    BorderThickness="1"
                                                    Height="35"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Width="107">
                                                <TextBlock Text="{Binding Ip}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" />
                                            </Border>
                                            <Border Grid.Column="2" 
                                                    BorderBrush="#E6E6E6" 
                                                    BorderThickness="1"
                                                    Height="35"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Width="107">
                                                <TextBlock Text="{Binding DirectionText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="14" />
                                            </Border>
                                            <Button Grid.Column="3"
                                                    Content="删除"
                                                    Command="{Binding $parent[ListBox].((vm:SettingsWindowViewModel)DataContext).RemoveLicensePlateRecognitionCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    Foreground="Red"
                                                    BorderThickness="0"
                                                    Width="107"
                                                    Height="35"
                                                    Margin="0,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- System Settings Group -->
                    <Border x:Name="SystemSettings" 
                            Classes="section-header"
                            Padding="0,0,0,0">
                        <TextBlock Text="系统设置"
                                   FontSize="14"
                                   Background="White"
                                   Foreground="Black"
                                   Margin="10,0,0,-15"
                                   Width="80"
                                   TextAlignment="Center" />
                    </Border>
                    <Border Padding="20" Margin="0,0,0,0">
                        <StackPanel Spacing="12">

                        <CheckBox Content="开机自动启动"
                                  IsChecked="{Binding EnableAutoStart}" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12"
                              ColumnSpacing="12">
                            <TextBlock Text="服务地址:"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="120" />
                            <TextBox Text="{Binding Urls}"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Watermark="localhost:9960 或 http://192.168.1.100:9960" />

                            <TextBlock Text="拍照码流类型:"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="120" />
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
                                <ComboBox ItemsSource="{Binding StreamTypeOptions}"
                                          SelectedItem="{Binding CaptureStreamType}"
                                          Grid.Column="0"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ., Converter={StaticResource StreamTypeConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="测试拍照"
                                        Grid.Column="1"
                                        Command="{Binding TestCaptureCommand}"
                                        Classes="primary-button"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        CornerRadius="4" />
                            </Grid>

                            <TextBlock Text="拍照摄像头类型:"
                                       Grid.Row="2"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="120" />
                            <ComboBox ItemsSource="{Binding SnapshotCameraTypeOptions}"
                                      SelectedItem="{Binding SnapshotCameraType}"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., Converter={StaticResource SnapshotCameraTypeConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    </Border>

                    <!-- Sound Device Settings Group -->
                    <Border x:Name="SoundSettings" 
                            Classes="section-header"
                            Padding="0,0,0,0">
                        <TextBlock Text="音响设备设置"
                                   FontSize="14"
                                   Background="White"
                                   Foreground="Black"
                                   Margin="10,0,0,-15"
                                   Width="80"
                                   TextAlignment="Center" />
                    </Border>
                    <Border Padding="20" Margin="0,0,0,0">
                        <StackPanel Spacing="12">

                        <CheckBox Content="启用音响设备"
                                  IsChecked="{Binding SoundDeviceEnabled}" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12"
                              ColumnSpacing="12">
                            <TextBlock Text="本地IP地址:"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="160" />
                            <TextBox Text="{Binding SoundDeviceLocalIP}"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Watermark="192.168.1.100" />

                            <TextBlock Text="音响设备IP:"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="160" />
                            <TextBox Text="{Binding SoundDeviceSoundIP}"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Watermark="192.168.1.200" />

                            <TextBlock Text="音响设备序列号:"
                                       Grid.Row="2"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="160" />
                            <TextBox Text="{Binding SoundDeviceSoundSN}"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Watermark="SN123456" />

                            <TextBlock Text="音量(0-100):"
                                       Grid.Row="3"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="160" />
                            <TextBox Text="{Binding SoundDeviceSoundVolume}"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     Watermark="0" />
                        </Grid>
                    </StackPanel>
                    </Border>

                    <!-- Printer Settings Group -->
                    <Border x:Name="PrinterSettings" 
                            Classes="section-header"
                            Padding="0,0,0,0">
                        <TextBlock Text="打印机设置"
                                   FontSize="14"
                                   Background="White"
                                   Foreground="Black"
                                   Margin="10,0,0,-15"
                                   Width="80"
                                   TextAlignment="Center" />
                    </Border>
                    <Border Padding="20" Margin="0,0,0,0">
                        <StackPanel Spacing="12">

                        <CheckBox Content="启用打印机功能"
                                  IsChecked="{Binding EnablePrinter}" />

                        <Grid ColumnDefinitions="Auto,*"
                              RowDefinitions="Auto"
                              RowSpacing="12"
                              ColumnSpacing="12">
                            <TextBlock Text="票据打印机:"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="Black"
                                       MinWidth="120" />
                            <ComboBox ItemsSource="{Binding AvailablePrinters}"
                                      SelectedItem="{Binding SelectedPrinterName}"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      PlaceholderText="请选择打印机"
                                      IsEnabled="{Binding EnablePrinter}" />
                        </Grid>
                    </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Save Button (Bottom Center) -->
        <Button Grid.Row="1" 
                Grid.Column="1"
                Content="确认保存"
                Command="{Binding SaveCommand}"
                Background="#4A85F9"
                Foreground="White"
                FontWeight="Bold"
                FontSize="14"
                Width="120"
                Height="35"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,30"
                CornerRadius="4" />

    </Grid>
</Window>