<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MaterialClient.Views.AttendedWeighing.DataManagementDialogWindow"
        Title="台账管理"
        Width="1100"
        Height="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="White"
        Icon="/Assets/fd-ico.ico">

  <Border BorderBrush="LightGray" BorderThickness="1">
    <Grid RowDefinitions="50,*,50">

      <!-- 标题栏 -->
      <Grid Grid.Row="0" Background="#6498FE">
        <TextBlock Text="台账管理"
                   FontSize="14"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Margin="15,0,0,0" />
        <Button Content="✕"
                Classes="transparent-button"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="20"
                Foreground="White"
                Width="40"
                Height="35"
                Click="OnCloseButtonClick"
                Cursor="Hand" />
      </Grid>

      <!-- 查询区 + 表格 -->
      <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0">

        <!-- 查询条件区域 -->
        <Grid RowDefinitions="Auto" Margin="10,10,10,5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 车牌号码 -->
            <TextBox Grid.Column="0"
                     Margin="5"
                     Width="110"
                     Height="30"
                     Watermark="车牌号码"
                     VerticalContentAlignment="Center" />

            <!-- 发货单号 -->
            <TextBox Grid.Column="1"
                     Margin="5"
                     Width="110"
                     Height="30"
                     Watermark="发货单号"
                     VerticalContentAlignment="Center" />

            <!-- 商品名称 -->
            <TextBox Grid.Column="2"
                     Margin="5"
                     Width="110"
                     Height="30"
                     Watermark="商品名称"
                     VerticalContentAlignment="Center" />

            <!-- 状态 -->
            <ComboBox Grid.Column="3"
                      Margin="5"
                      Width="110"
                      Height="30"
                      VerticalContentAlignment="Center"
                      SelectedIndex="0">
              <ComboBoxItem Content="状态(全部)" />
              <ComboBoxItem Content="收货中" />
              <ComboBoxItem Content="已收货" />
              <ComboBoxItem Content="已取消" />
            </ComboBox>

            <!-- 进场日期范围 -->
            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="5,0">
              <TextBlock Text="进场日期：" VerticalAlignment="Center" Margin="0,0,4,0" />
              <DatePicker Width="120" Height="30" />
            </StackPanel>

            <TextBlock Grid.Column="5"
                       Text="-"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,0" />

            <DatePicker Grid.Column="6"
                        Margin="5"
                        Width="120"
                        Height="30" />

            <!-- 查询按钮 -->
            <Button Grid.Column="7"
                    Content="查询"
                    Width="80"
                    Height="30"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="primary-button" />
          </Grid>
        </Grid>

        <!-- 表格区域 -->
        <DataGrid Grid.Row="1"
                  Margin="10,0,10,5"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Items="{Binding Records}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding OrderNo}" Header="运单号" />
            <DataGridTextColumn Binding="{Binding TruckNo}" Header="车牌号" />
            <DataGridTextColumn Binding="{Binding TypeName}" Header="类型" />
            <DataGridTextColumn Binding="{Binding GoodsNameSize}" Header="商品" />
            <DataGridTextColumn Binding="{Binding OrderTypeName}" Header="状态" />
            <DataGridTextColumn Binding="{Binding GoodsPlanOnPcsDesc}" Header="运单数量" />
            <DataGridTextColumn Binding="{Binding GoodsPlanOnWeightDesc}" Header="运单重量" />
            <DataGridTextColumn Binding="{Binding GoodsTakeWeightDesc}" Header="扣量" />
            <DataGridTextColumn Binding="{Binding GoodsPcsDesc}" Header="实际数量" />
            <DataGridTextColumn Binding="{Binding GoodsWeightDesc}" Header="实际重量" />
            <DataGridTextColumn Binding="{Binding UnitNameRate}" Header="单位换算" />
            <DataGridTextColumn Binding="{Binding JoinTime}" Header="进场时间" />
            <DataGridTextColumn Binding="{Binding OutTime}" Header="出场时间" />
            <DataGridTextColumn Binding="{Binding ProviderName}" Header="供应商" />
            <DataGridTextColumn Binding="{Binding DispatchNo}" Header="发货单号" />
            <DataGridTextColumn Binding="{Binding Remark}" Header="备注" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- 分页与统计信息区域 -->
      <Grid Grid.Row="2"
            Margin="10,0,10,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左侧分页按钮 -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
          <Button Content="首页" Width="75" Height="30" />
          <Button Content="上一页" Width="75" Height="30" />
          <Button Content="下一页" Width="75" Height="30" />
          <Button Content="末页" Width="75" Height="30" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="跳转到" VerticalAlignment="Center" />
            <TextBox Width="40"
                     Height="26"
                     TextAlignment="Center"
                     Text="1" />
            <TextBlock Text="页" VerticalAlignment="Center" />
            <Button Content="确定" Width="60" Height="26" Margin="4,0,0,0" />
          </StackPanel>
        </StackPanel>

        <!-- 中间空白占位 -->
        <Grid Grid.Column="1" />

        <!-- 右侧统计与确定按钮 -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
          <TextBlock Text="现页数：" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" />
          <TextBlock Text="总条数：" VerticalAlignment="Center" Margin="8,0,0,0" />
          <TextBlock Text="{Binding TotalCount}" VerticalAlignment="Center" />
          <TextBlock Text="总页数：" VerticalAlignment="Center" Margin="8,0,0,0" />
          <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" />

          <Button Content="确定"
                  Width="80"
                  Height="30"
                  Margin="16,0,0,0"
                  Classes="primary-button"
                  Click="OnConfirmButtonClick" />
        </StackPanel>
      </Grid>

    </Grid>
  </Border>
</Window>

