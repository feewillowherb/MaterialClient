<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MaterialClient.Views.AttendedWeighing"
        xmlns:u="https://irihi.tech/ursa"
        xmlns:viewModels="clr-namespace:MaterialClient.ViewModels"
        x:Class="MaterialClient.Views.AttendedWeighing.DataManagementDialogWindow"
        x:DataType="viewModels:DataManagementDialogViewModel"
        Title="台账管理"
        Width="1200"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="White"
        Icon="/Assets/fd-ico.ico">

  <Border BorderBrush="LightGray" BorderThickness="1">
    <Grid RowDefinitions="50,Auto,50">

      <!-- 标题栏 -->
      <Grid Grid.Row="0" Background="#6498FE">
        <TextBlock Text="台账管理"
                   FontSize="14"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Margin="15,0,0,0" />
        <Button Content="✕"
                Classes="transparent-button"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="20"
                Foreground="White"
                Width="40"
                Height="35"
                Command="{Binding CloseCommand}"
                Cursor="Hand" />
      </Grid>

      <!-- 查询区 + 表格（表格禁用垂直滚动，高度随行数自动计算） -->
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Margin="0">

        <!-- 查询条件区域：与 SolidWasteExportFilter 对齐 -->
        <Grid RowDefinitions="Auto" Margin="10,10,10,5">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Margin="5"
                     Width="110"
                     Height="30"
                     Watermark="车牌号"
                     Text="{Binding PlateNumber}"
                     VerticalContentAlignment="Center" />

            <!-- <TextBox Grid.Column="1" -->
            <!--          Margin="5" -->
            <!--          Width="110" -->
            <!--          Height="30" -->
            <!--          Watermark="货名" -->
            <!--          Text="{Binding GoodsName}" -->
            <!--          VerticalContentAlignment="Center" /> -->

            <TextBox Grid.Column="2"
                     Margin="5"
                     Width="110"
                     Height="30"
                     Watermark="发货单位"
                     Text="{Binding ProviderName}"
                     VerticalContentAlignment="Center" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="5,0">
              <TextBlock Text="进场日期："
                         VerticalAlignment="Center"
                         Margin="0,0,4,0" />
              <u:DateTimePicker MinWidth="150"
                                Width="170"
                                Height="30"
                                SelectedDate="{Binding StartDate}"
                                DisplayFormat="yyyy-MM-dd"
                                PanelFormat="yyyy-MM-dd" />
            </StackPanel>

            <TextBlock Grid.Column="4"
                       Text="-"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,0" />

            <u:DateTimePicker Grid.Column="5"
                              Margin="5"
                              MinWidth="150"
                              Width="170"
                              Height="30"
                              SelectedDate="{Binding EndDate}"
                              DisplayFormat="yyyy-MM-dd"
                              PanelFormat="yyyy-MM-dd" />

            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
              <Button Content="查询"
                      Width="80"
                      Height="30"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      Classes="primary-button"
                      Command="{Binding QueryCommand}" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- 表格区域：17 列与 SolidWasteExcelExportService 一致；禁用垂直滚动，高度随 PageSize 自动计算 -->
        <DataGrid Grid.Row="1"
                  RowHeight="30"
                  VerticalScrollBarVisibility="Disabled"
                  Margin="10,0,10,5"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True"
                  ItemsSource="{Binding Records}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding SerialNumber}" Header="流水号" MinWidth="120" />
            <DataGridTextColumn Binding="{Binding VehicleNumber}" Header="车  号" MinWidth="80" />
            <DataGridTextColumn Binding="{Binding ShippingUnit}" Header="发货单位" MinWidth="120" />
            <DataGridTextColumn Binding="{Binding ReceivingUnit}" Header="收货单位" MinWidth="120" />
            <DataGridTextColumn Binding="{Binding GoodsName}" Header="货  名" MinWidth="100" />
            <DataGridTextColumn Binding="{Binding GrossWeight}" Header="毛  重" MinWidth="80" />
            <DataGridTextColumn Binding="{Binding TareWeight}" Header="皮  重" MinWidth="80" />
            <DataGridTextColumn Binding="{Binding NetWeight}" Header="净  重" MinWidth="80" />
            <DataGridTextColumn Binding="{Binding Remark}" Header="备 注" MinWidth="100" />
            <DataGridTextColumn Binding="{Binding GrossWeightTime}" Header="毛重时间" MinWidth="140" />
            <DataGridTextColumn Binding="{Binding TareWeightTime}" Header="皮重时间" MinWidth="140" />
            <DataGridTextColumn Binding="{Binding Street}" Header="所属街道" MinWidth="100" />
            <DataGridTextColumn Binding="{Binding SolidWasteType}" Header="类型" MinWidth="80" />
            <DataGridTextColumn Binding="{Binding ManifestNumber}" Header="联单编号" MinWidth="110" />
            <DataGridTextColumn Binding="{Binding UploadResult}" Header="上传结果" MinWidth="80" />
            <DataGridTextColumn Binding="{Binding UploadStatus}" Header="上传状态" MinWidth="80" />
            <DataGridTextColumn Binding="{Binding UploadTime}" Header="上传时间" MinWidth="140" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- 分页与统计信息区域 -->
      <Grid Grid.Row="2"
            Margin="10,0,10,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <u:Pagination Grid.Column="0"
                      CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                      TotalCount="{Binding TotalCount}"
                      PageSize="{Binding PageSize}"
                      Command="{Binding PageChangeCommand}" />

        <Grid Grid.Column="1" />

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">

          <Button Content="导出"
                  Width="80"
                  Height="30"
                  Margin="8,0,0,0"
                  Classes="primary-button"
                  Command="{Binding ExportCommand}" />
          <Button Content="关闭"
                  Width="80"
                  Height="30"
                  Margin="8,0,0,0"
                  Classes="primary-button"
                  Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </Grid>

    </Grid>
  </Border>
</Window>
