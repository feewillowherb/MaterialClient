<TemplatedControl xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:u="https://irihi.tech/ursa"
                  x:Class="MaterialClient.Views.SearchablePageableSelectBox">

  <TemplatedControl.Template>
    <ControlTemplate>
      <StackPanel>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="0">
          <Grid>
            <TextBox Name="PART_TextBox"
                     Watermark="{TemplateBinding Watermark}"
                     Margin="8,0,8,0"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Stretch" />

            <Path Data="M0,0 L0,10 L5,5 Z"
                  Fill="Gray"
                  Width="10"
                  Height="10"
                  HorizontalAlignment="Right"
                  Margin="0,0,8,0"
                  IsVisible="{TemplateBinding IsPopupOpen}" />
          </Grid>
        </Border>

        <Popup Name="PART_Popup"
               IsOpen="{TemplateBinding IsPopupOpen}"
               Placement="Bottom"
               PlacementTarget="PART_Border">
          <Border Background="White"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="8"
                  Width="400"
                  MaxHeight="400">
            <StackPanel>
              <Grid Height="300">
                <ListBox Name="PART_ItemsList"
                         ItemsSource="{TemplateBinding Items}"
                         SelectedItem="{TemplateBinding SelectedItem, Mode=TwoWay}"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch" />

                <Border Background="White"
                        IsVisible="{TemplateBinding IsLoading}">
                  <TextBlock Text="加载中..."
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Foreground="Gray" />
                </Border>
              </Grid>

              <Grid Margin="0,8,0,0">
                <u:Pagination CurrentPage="{TemplateBinding CurrentPage}"
                              TotalCount="{TemplateBinding TotalCount}"
                              PageSize="{TemplateBinding PageSize}"
                              Command="{TemplateBinding PageChangeCommand}"
                              HorizontalAlignment="Center" />
              </Grid>

              <Border Margin="0,8,0,0"
                      Background="#F0F0F0"
                      CornerRadius="4"
                      Padding="8,4"
                      IsVisible="{TemplateBinding ShowAddNew}">
                <Button Name="PART_AddNew"
                        Command="{TemplateBinding AddNewCommand}"
                        HorizontalAlignment="Center"
                        Content="+ 新建" />
              </Border>

              <StackPanel Orientation="Horizontal"
                          Margin="0,8,0,0"
                          HorizontalAlignment="Center">
                <TextBlock Text="{TemplateBinding CurrentPageInfo}"
                           Foreground="Gray"
                           Margin="0,0,8,0" />
                <TextBlock Text="{TemplateBinding TotalCountInfo}"
                           Foreground="Gray" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
    </ControlTemplate>
  </TemplatedControl.Template>

</TemplatedControl>
