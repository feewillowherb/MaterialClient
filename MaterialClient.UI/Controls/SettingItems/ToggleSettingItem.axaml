<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MaterialClient.UI.Controls.SettingItems.ToggleSettingItem"
             x:Name="Root">
    <Grid ColumnDefinitions="*,Auto" Margin="0,8">
        <TextBlock Grid.Column="0" Text="{Binding Label, ElementName=Root}"
                   FontSize="13" Foreground="#333" VerticalAlignment="Center"
                   FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Value, ElementName=Root}"
                      VerticalAlignment="Center" />
    </Grid>
</UserControl>
