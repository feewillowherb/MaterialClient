<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MaterialClient.UI.Controls.SettingItems.SliderSettingItem"
             x:Name="Root">
    <Grid RowDefinitions="Auto,Auto" Margin="0,8">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Label, ElementName=Root}"
                       FontSize="13" Foreground="#333" VerticalAlignment="Center"
                       FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
            <TextBlock Grid.Column="1" Text="{Binding Value, ElementName=Root, StringFormat='{}{0}'}"
                       FontSize="13" Foreground="#666" VerticalAlignment="Center" />
        </Grid>
        <Slider Grid.Row="1" Minimum="{Binding Minimum, ElementName=Root}"
                Maximum="{Binding Maximum, ElementName=Root}"
                Value="{Binding Value, ElementName=Root}"
                TickFrequency="{Binding Step, ElementName=Root}"
                IsSnapToTickEnabled="True"
                Margin="0,4,0,0" />
    </Grid>
</UserControl>
