<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MaterialClient.Views.Dialogs.CreateProviderDialog"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="White"
        Title="新增供应商">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="20">
    <TextBlock x:Name="MessageText"
               Text="将新增一条供应商："
               FontSize="13"
               Foreground="#666"
               TextWrapping="Wrap" />

    <StackPanel Grid.Row="1" Margin="0,12,0,0">
      <TextBlock Text="供应商名称"
                 FontSize="13"
                 Foreground="#333" />
      <TextBox x:Name="NameTextBox"
               Margin="0,4,0,0"
               FontSize="13"
               Watermark="请输入供应商名称（必填）"
               VerticalContentAlignment="Center" />
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock Text="收货地址"
                 FontSize="13"
                 Foreground="#333" />
      <TextBox x:Name="AddressTextBox"
               Margin="0,4,0,0"
               FontSize="13"
               Watermark="可选，不填则留空"
               VerticalContentAlignment="Center" />
    </StackPanel>

    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="12"
                Margin="0,16,0,0">
      <Button Content="取消"
              Padding="24,8"
              Click="OnCancelClick" />
      <Button Content="确认"
              Padding="24,8"
              Click="OnConfirmClick" />
    </StackPanel>
  </Grid>
</Window>
