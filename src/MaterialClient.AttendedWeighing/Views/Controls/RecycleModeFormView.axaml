<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MaterialClient.ViewModels"
             xmlns:views="using:MaterialClient.Views.Controls"
             x:Class="MaterialClient.Views.Controls.RecycleModeFormView"
             x:DataType="vm:RecycleWeighingDetailViewModel">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="180" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderThickness="0,4,0,0"
                BorderBrush="#B0EBFF"
                Background="White"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel Spacing="6">
                <!-- 称重类型（Waybill 仅显示不可编辑） -->
                <Grid ColumnDefinitions="72,*">
                    <Label Content="称重类型"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1"
                              Height="20"
                              FontSize="12"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding DeliveryTypeOptions}"
                              SelectedValue="{Binding SelectedDeliveryType}"
                              SelectedValueBinding="{Binding Value}"
                              IsVisible="{Binding IsWeighingRecord}"
                              Margin="0,5,0,5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DeliveryTypeDisplayText}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#333333"
                               IsVisible="{Binding !IsWeighingRecord}"
                               Margin="0,5,0,5" />
                </Grid>

                <!-- 车牌号 -->
                <Grid ColumnDefinitions="72,*">
                    <Label Content="车牌号"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,8,0" />
                    <TextBox Grid.Column="1"
                             Height="20"
                             Text="{Binding PlateNumber}"
                             TextAlignment="Left"
                             FontSize="12"
                             Margin="0,5,0,5" />
                </Grid>

                <!-- 供应商 -->
                <Grid ColumnDefinitions="72,*">
                    <Label Content="{Binding ProviderLabelText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,8,0" />
                    <views:SearchableSelectionBox x:Name="ProvidersSelectionBox"
                                                 Grid.Column="1"
                                                 Height="32"
                                                 SelectedItem="{Binding SelectedProviderItem, Mode=TwoWay}"
                                                 LoadPageAsync="{Binding ProviderLoadPageAsync}"
                                                 CreateNewAsync="{Binding ProviderCreateNewAsync}"
                                                 Watermark="请选择供应商"
                                                 Margin="0,5,0,5" />
                </Grid>

                <!-- 材料名称 -->
                <Grid ColumnDefinitions="72,*">
                    <Label Content="材料名称"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,8,0" />
                    <views:SearchableSelectionBox x:Name="MaterialsSelectionBox"
                                                 Grid.Column="1"
                                                 Height="32"
                                                 SelectedItem="{Binding SelectedMaterialItem, Mode=TwoWay}"
                                                 LoadPageAsync="{Binding MaterialLoadPageAsync}"
                                                 CreateNewAsync="{Binding MaterialCreateNewAsync}"
                                                 Watermark="请选择材料"
                                                 Margin="0,5,0,5" />
                </Grid>

                <!-- 单价（元/吨） -->
                <Grid ColumnDefinitions="72,*">
                    <Label Content="单价"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,8,0" />
                    <TextBox Grid.Column="1"
                             Height="20"
                             Text="{Binding UnitPrice, Mode=TwoWay, TargetNullValue=''}"
                             Watermark="元/吨"
                             TextAlignment="Left"
                             FontSize="12"
                             Margin="0,5,0,5" />
                </Grid>

                <!-- 合同编号 -->
                <Grid ColumnDefinitions="72,*">
                    <Label Content="合同编号"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,8,0" />
                    <TextBox Grid.Column="1"
                             Height="20"
                             Text="{Binding SaleContractNo, Mode=TwoWay, TargetNullValue=''}"
                             TextAlignment="Left"
                             FontSize="12"
                             Margin="0,5,0,5" />
                </Grid>

                <!-- 备注 -->
                <Grid ColumnDefinitions="72,*">
                    <Label Content="备注"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,8,0" />
                    <TextBox Grid.Column="1"
                             Height="20"
                             TextWrapping="Wrap"
                             Text="{Binding Remark}"
                             TextAlignment="Left"
                             FontSize="12"
                             Margin="0,5,0,5" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 下方空白内容区域 -->
        <Border Grid.Row="1"
                BorderThickness="0"
                BorderBrush="#E5E7EB"
                Background="White"
                CornerRadius="4"
                Margin="0,0,0,0">
            <Grid />
        </Border>
    </Grid>
</UserControl>
