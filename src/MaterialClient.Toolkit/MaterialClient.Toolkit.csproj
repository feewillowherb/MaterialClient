<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>MaterialClient.Toolkit</RootNamespace>
        <OutputType>Exe</OutputType>
        <Description>物料客户端工具库 - 通用工具和实用程序</Description>
        <!-- 自包含部署：包含 .NET 运行时，目标机器无需安装 .NET -->
        <SelfContained>true</SelfContained>
        <!-- 单文件发布：将所有文件打包成一个可执行文件 -->
        <PublishSingleFile>true</PublishSingleFile>
        <!-- 包含所有依赖项 -->
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <!-- 运行时标识符：Windows x64 -->
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <!-- 发布时裁剪未使用的代码（可选，减小文件大小） -->
        <PublishTrimmed>false</PublishTrimmed>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\MaterialClient.Common\MaterialClient.Common.csproj" />
        <ProjectReference Include="..\MaterialClient.Common.EntityFrameworkCore\MaterialClient.Common.EntityFrameworkCore.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
        <PackageReference Include="Magicodes.IE.Csv" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
        <PackageReference Include="SQLitePCLRaw.bundle_zetetic" />
        <PackageReference Include="Volo.Abp.Core" />
        <PackageReference Include="Volo.Abp.Autofac" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <!-- 单文件发布时，将 appsettings.json 作为独立文件，不打包到单文件中 -->
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </None>
    </ItemGroup>

    <ItemGroup>
      <None Update="Csv\**\*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Csv\" />
    </ItemGroup>

</Project>
