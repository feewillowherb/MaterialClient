<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MaterialClient.ViewModels"
        xmlns:views="using:MaterialClient.Views.Controls"
        xmlns:views1="clr-namespace:MaterialClient.Views.Controls"
        xmlns:ursa="using:Ursa.Controls"
        xmlns:ui="using:MaterialClient.UI.Controls"
        x:Class="MaterialClient.Views.AttendedWeighing.AttendedWeighingWindow"
        x:DataType="vm:AttendedWeighingViewModel"
        x:Name="AttendedWeighingWindowRoot"
        Title="有人值守"
        Width="1366"
        Height="768"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="White"
        Icon="/Assets/fd-ico.ico">
    <Panel>
        <ui:WeighingWindowBase x:Name="WeighingWindowBase"
                               TitleBarPointerPressed="TitleBar_OnPointerPressed"
                               MinimizeButtonClick="OnMinimizeButtonClick"
                               CloseButtonClick="OnCloseButtonClick"
                               DeviceStatuses="{Binding DeviceStatuses}"
                               CameraStatusDetails="{Binding CameraStatusDetails}"
                               StatusBarBackground="#F5F5F5"
                               StatusBarBorderBrush="#E5E7EB"
                               StatusBarPadding="16,8">
            <ui:WeighingWindowBase.LogoContent>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="/Assets/Indexlogo.png" Width="210" Height="32" Stretch="Uniform" />
                </StackPanel>
            </ui:WeighingWindowBase.LogoContent>

            <ui:WeighingWindowBase.MenuContent>
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="-450,0,0,0">
                        <Button x:Name="DataManagementButton"
                                Content="数据管理"
                                Classes="transparent-button"
                                Foreground="White"
                                Padding="8,4"
                                Click="OnDataManagementMenuClick" />
                        <Button Content="系统设置"
                                Classes="transparent-button"
                                Foreground="White"
                                Padding="8,4"
                                Command="{Binding OpenSettingsCommand}" />
                        <Button Content="项目信息"
                                Classes="transparent-button"
                                Foreground="White"
                                Padding="8,4"
                                Command="{Binding OpenProjectInfoCommand}" />
                        <Button Content="数据同步"
                                Classes="transparent-button"
                                Foreground="White"
                                Padding="8,4"
                                Command="{Binding SyncDataCommand}" />
                        <Button Content="退出登录"
                                Classes="transparent-button"
                                Foreground="White"
                                Padding="8,4"
                                Command="{Binding LogoutCommand}" />
                        <Button Content="导出"
                                Classes="transparent-button"
                                Foreground="White"
                                Padding="8,4"
                                Command="{Binding ExportSolidWasteCommand}"
                                IsVisible="False" />
                    </StackPanel>

                    <Popup x:Name="DataManagementMenuPopup"
                           Placement="Bottom"
                           IsLightDismissEnabled="True"
                           VerticalOffset="2"
                           HorizontalOffset="0">
                        <Border Background="#2E5A9E"
                                CornerRadius="4"
                                Padding="0,4"
                                MinWidth="140">
                            <StackPanel Spacing="0">
                                <Button Padding="12,10"
                                        Click="OnMaterialManagementClick"
                                        Classes="popup-menu-item-button">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="&#x25C6;"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.9" />
                                        <TextBlock Text="材料管理" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,10"
                                        Click="OnSupplyManagementClick"
                                        Classes="popup-menu-item-button">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="&#x25CF;"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.9" />
                                        <TextBlock Text="供应管理" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,10"
                                        Click="OnLedgerManagementClick"
                                        Classes="popup-menu-item-button">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="&#x25A4;"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.9" />
                                        <TextBlock Text="台账管理" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </ui:WeighingWindowBase.MenuContent>

            <ui:WeighingWindowBase.WeightContent>
                <Grid Background="#4A85F9">
                    <Border>
                        <Border.Background>
                            <ImageBrush Source="/Assets/Indexbanner.png"
                                        Stretch="UniformToFill"
                                        AlignmentX="Center"
                                        AlignmentY="Center" />
                        </Border.Background>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Margin="24,32"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid Grid.Column="1"
                              HorizontalAlignment="Center"
                              ColumnDefinitions="Auto,Auto,Auto,Auto"
                              RowDefinitions="Auto">
                            <Border Grid.Row="0"
                                    Background="#5A7FE6"
                                    CornerRadius="8"
                                    Padding="20,12"
                                    VerticalAlignment="Center"
                                    MinWidth="180">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-60" />
                                </Border.RenderTransform>
                                <TextBlock Text="{Binding MostFrequentPlateNumber, TargetNullValue='--'}"
                                           Foreground="White"
                                           FontSize="16" />
                            </Border>

                            <Border Grid.Column="1"
                                    Grid.Row="0"
                                    Grid.ColumnSpan="3"
                                    Background="#5A7FE6"
                                    CornerRadius="8"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Padding="0">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <Border Grid.Column="0"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Vertical">
                                            <views1:AnimatedDeliveryTypeRadioButton Text="收料"
                                                                                    GroupName="DeliveryType"
                                                                                    IsChecked="{Binding IsReceiving}"
                                                                                    Command="{Binding SetReceivingCommand}"
                                                                                    IsWeighingActive="{Binding IsWeighingActive}"
                                                                                    CornerRadius="8,8,0,0"
                                                                                    ContentPadding="20,10" />
                                            <views1:AnimatedDeliveryTypeRadioButton Text="发料"
                                                                                    GroupName="DeliveryType"
                                                                                    IsChecked="{Binding IsSending}"
                                                                                    Command="{Binding SetSendingCommand}"
                                                                                    IsWeighingActive="{Binding IsWeighingActive}"
                                                                                    CornerRadius="0,0,8,8"
                                                                                    ContentPadding="20,10" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CurrentWeight, StringFormat='{}{0:F2}'}"
                                               Foreground="White"
                                               FontSize="64"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="70,0,70,0" />

                                    <StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0,16,0">
                                        <Border Width="1"
                                                Height="30"
                                                Background="White"
                                                Opacity="0.3"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="吨"
                                                   Foreground="White"
                                                   FontSize="24"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="3"
                                       Inlines="{Binding DeliveryTypeNotificationInlines}"
                                       Opacity="{Binding DeliveryTypeNotificationOpacity}"
                                       FontSize="14"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="0,0,0,0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform Y="90" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.5" />
                                    </Transitions>
                                </TextBlock.Transitions>
                            </TextBlock>
                        </Grid>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentWeighingStatusText}"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="-150,0,0,0" />

                        <views1:LoadingDotsAnimation Grid.Column="2"
                                                     IsActive="{Binding IsWeighingActive}"
                                                     Foreground="White"
                                                     FontSize="18"
                                                     FontWeight="Bold"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Left"
                                                     Margin="-75,0,0,0" />
                    </Grid>
                </Grid>
            </ui:WeighingWindowBase.WeightContent>

            <ui:WeighingWindowBase.ContentArea>
                <Grid Background="White" ColumnDefinitions="280,*,360" Margin="0">
                    <views:WeighingRecordListView Grid.Column="0" DataContext="{Binding}" />

                    <Grid Grid.Column="1">
                        <views:AttendedWeighingMainView DataContext="{Binding}"
                                                        IsVisible="{Binding #AttendedWeighingWindowRoot.((vm:AttendedWeighingViewModel)DataContext).IsShowingMainView}" />
                        <views:AttendedWeighingDetailView DataContext="{Binding DetailViewModel}"
                                                          IsVisible="{Binding #AttendedWeighingWindowRoot.((vm:AttendedWeighingViewModel)DataContext).IsShowingDetailView}" />
                    </Grid>

                    <Border Grid.Column="2"
                            Background="#F8F9FA"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1,0,0,0"
                            Padding="10">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                            <views1:PhotoGridView Grid.RowSpan="2" DataContext="{Binding PhotoGridViewModel}" />
                            <TextBlock Grid.Row="2"
                                       Text="单据扫描"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,12,0,8" />
                            <Border Grid.Row="3"
                                    Classes="card-border"
                                    Height="240"
                                    Padding="12">
                                <Grid RowDefinitions="*,Auto">
                                    <Border Background="#F0F0F0"
                                            CornerRadius="4"
                                            BorderBrush="#D1D5DB"
                                            BorderThickness="1"
                                            Margin="0,0,0,0">
                                        <Grid>
                                            <Image Source="{Binding UsbCameraPreview}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   IsVisible="{Binding ShouldShowPreview}" />
                                            <Image Source="{Binding BillPhotoPath, Converter={StaticResource NullOrEmptyImageConverter}}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"
                                                   IsVisible="{Binding !ShouldShowPreview}" />
                                            <TextBlock Text="高拍仪未连接"
                                                       FontSize="14"
                                                       Foreground="#999"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsUsbCameraOnline}" />
                                        </Grid>
                                    </Border>

                                    <Button Grid.Row="1"
                                            Content="{Binding BillPhotoButtonText}"
                                            Classes="success-button"
                                            CornerRadius="6"
                                            Width="80"
                                            Height="28"
                                            FontSize="12"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Margin="0,5,0,0"
                                            Command="{Binding TakeBillPhotoCommand}"
                                            IsVisible="{Binding IsShowingDetailView}"
                                            IsEnabled="{Binding IsUsbCameraOnline}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ui:WeighingWindowBase.ContentArea>
        </ui:WeighingWindowBase>

        <ursa:OverlayDialogHost />
    </Panel>
</Window>