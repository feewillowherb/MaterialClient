<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:MaterialClient.UI.Controls"
             x:Class="MaterialClient.UI.Controls.WeighingWindowBase"
             x:Name="Root">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryBlue}"
                Padding="16,6,0,6"
                PointerPressed="OnTitleBarPointerPressed"
                Cursor="Arrow">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <ContentControl Grid.Column="0"
                                Content="{Binding LogoContent, ElementName=Root}"
                                VerticalAlignment="Center" />

                <ContentControl Grid.Column="1"
                                Content="{Binding MenuContent, ElementName=Root}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="0,-4,0,0">
                    <Button Content="─"
                            FontSize="16"
                            Width="40"
                            Height="40"
                            Cursor="Hand"
                            IsVisible="{Binding CanMinimize, ElementName=Root}"
                            Click="OnMinimizeButtonClick"
                            Classes="titlebar-minimize-button" />

                    <Button Content="✕"
                            FontSize="18"
                            Width="40"
                            Height="40"
                            Cursor="Hand"
                            IsVisible="{Binding CanClose, ElementName=Root}"
                            Click="OnCloseButtonClick"
                            Classes="titlebar-close-button" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1"
                        IsVisible="{Binding ShowWeightDisplay, ElementName=Root}"
                        Content="{Binding WeightContent, ElementName=Root}" />

        <ContentControl Grid.Row="2"
                        Content="{Binding ContentArea, ElementName=Root}" />

        <Border Grid.Row="3"
                Background="{Binding StatusBarBackground, ElementName=Root}"
                BorderBrush="{Binding StatusBarBorderBrush, ElementName=Root}"
                BorderThickness="0,1,0,0"
                Padding="{Binding StatusBarPadding, ElementName=Root}">
            <ui:DeviceStatusBar ItemsSource="{Binding DeviceStatuses, ElementName=Root}"
                                CameraStatusDetails="{Binding CameraStatusDetails, ElementName=Root}" />
        </Border>
    </Grid>
</UserControl>
