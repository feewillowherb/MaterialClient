<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:MaterialClient.UI.Controls"
             x:Class="MaterialClient.UI.Controls.WeighingWindowBase"
             x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Row 0: Header Bar (PrimaryBlue) -->
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryBlue}"
                Padding="16,6,0,6"
                x:Name="PART_HeaderBar"
                PointerPressed="TitleBar_OnPointerPressed"
                Cursor="Arrow">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Col 0: HeaderLeftContent (logo/title) -->
                <ContentPresenter Content="{Binding HeaderLeftContent, ElementName=Root}" />

                <!-- Col 1: MenuItems (center menu) -->
                <ContentPresenter Grid.Column="1"
                                  Content="{Binding MenuItems, ElementName=Root}" />

                <!-- Col 2: Window Control Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Margin="0,-4,0,0">
                    <Button x:Name="PART_MinimizeButton"
                            Content="─"
                            FontSize="16"
                            Width="40"
                            Height="40"
                            Cursor="Hand"
                            Classes="titlebar-minimize-button"
                            Click="OnMinimizeButtonClick" />
                    <Button x:Name="PART_CloseButton"
                            Content="✕"
                            FontSize="18"
                            Width="40"
                            Height="40"
                            Cursor="Hand"
                            Classes="titlebar-close-button"
                            Click="OnCloseButtonClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: WeightAreaContent -->
        <ContentPresenter Grid.Row="1"
                          Content="{Binding WeightAreaContent, ElementName=Root}" />

        <!-- Row 2: MainContent -->
        <ContentPresenter Grid.Row="2"
                          Content="{Binding MainContent, ElementName=Root}" />

        <!-- Row 3: DeviceStatusBar (runtime binding: host ViewModel type varies by app) -->
        <Border Grid.Row="3"
                x:CompileBindings="False"
                Background="#F5F5F5"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <controls:DeviceStatusBar ItemsSource="{Binding DeviceStatuses}"
                                      CameraStatusDetails="{Binding CameraStatusDetails}" />
        </Border>

    </Grid>

</UserControl>
