<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:MaterialClient.UI.Models"
             x:Class="MaterialClient.UI.Controls.CameraStatusDetailPopup"
             x:Name="DetailPopupContent"
             Classes="card-border"
             Padding="12"
             MinWidth="300"
             MaxHeight="400">
    <ScrollViewer>
        <StackPanel Spacing="8">
            <TextBlock Text="摄像头在线状态"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#333"
                       Margin="0,0,0,4"
                       FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />

            <ItemsControl ItemsSource="{Binding CameraStatusDetails, ElementName=DetailPopupContent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CameraStatusDetailItem">
                        <Border Classes="section-border"
                                Padding="10,8"
                                Margin="0,0,0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                         IsVisible="{Binding IsOnline}">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="#10B981" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                         IsVisible="{Binding !IsOnline}">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="#EF4444" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#333"
                                               FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                    <TextBlock Text="{Binding DisplayAddress, StringFormat='IP: {0}'}"
                                               FontSize="11" Foreground="#666"
                                               FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="在线" FontSize="12" Foreground="#10B981"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           IsVisible="{Binding IsOnline}"
                                           FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                <TextBlock Grid.Column="2" Text="离线" FontSize="12" Foreground="#EF4444"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           IsVisible="{Binding !IsOnline}"
                                           FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="暂无摄像头配置"
                       FontSize="12"
                       Foreground="#999"
                       HorizontalAlignment="Center"
                       Padding="20"
                       IsVisible="{Binding !HasCameraStatusDetails, ElementName=DetailPopupContent}"
                       FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
