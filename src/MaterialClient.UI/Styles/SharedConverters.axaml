<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="using:MaterialClient.UI.Converters">

    <Style>
        <Style.Resources>
            <converters:EqualityToColorConverter x:Key="EqualityToColorConverter" />
            <converters:NullOrEmptyImageConverter x:Key="NullOrEmptyImageConverter" />
            <converters:BoolToBrushConverter x:Key="BoolToBrushConverter" />
            <converters:CarNullOrEmptyImageConverter x:Key="CarNullOrEmptyImageConverter" />
            <converters:NullableBitmapToImageConverter x:Key="NullableBitmapToImageConverter" />
            <converters:ScaleUnitConverter x:Key="ScaleUnitConverter" />
            <converters:ScaleTypeConverter x:Key="ScaleTypeConverter" />
            <converters:StreamTypeConverter x:Key="StreamTypeConverter" />
            <converters:LprDeviceTypeConverter x:Key="LprDeviceTypeConverter" />
            <converters:WeighingModeConverter x:Key="WeighingModeConverter" />
            <converters:MaterialUnitDisplayConverter x:Key="MaterialUnitDisplayConverter" />
            <converters:ProductCodeConverter x:Key="ProductCodeConverter" />
            <converters:AnomalyReasonConverter x:Key="AnomalyReasonConverter" />
        </Style.Resources>
    </Style>

</Styles>
