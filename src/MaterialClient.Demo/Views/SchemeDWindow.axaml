<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MaterialClient.Demo.Views.SchemeDWindow"
        Title="Scheme D: Checkbox / Selection Icon Column"
        Width="750" Height="420"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Scheme D: Checkbox column + subtle background highlight -->
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#F0F4FF" />
        </Style>

        <!-- Hover for unselected rows -->
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#F0F7FF" />
        </Style>

        <!-- Selected + hover keeps selected style -->
        <Style Selector="DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#F0F4FF" />
        </Style>

        <!-- DataGrid header style matching production -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#6498FE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="Height" Value="36" />
        </Style>
    </Window.Styles>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Scheme D: Checkbox / Selection Icon Column"
                       FontSize="16" FontWeight="Bold" />
            <TextBlock Text="Checkbox column + subtle background highlight (#F0F4FF)"
                       FontSize="12" Foreground="Gray" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  Name="DemoDataGrid"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <!-- Selection icon column -->
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Panel>
                                <Path Name="CheckIcon"
                                      Data="M4 12L8 16L16 6"
                                      Stroke="#4169E1"
                                      StrokeThickness="2.5"
                                      StrokeLineCap="Round"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Width="20" Height="20"
                                      IsVisible="False" />
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="License Plate" Width="110"
                                   Binding="{Binding LicensePlate}" />
                <DataGridTextColumn Header="Supplier" Width="150"
                                   Binding="{Binding Supplier}" />
                <DataGridTextColumn Header="Weight (ton)" Width="100"
                                   Binding="{Binding Weight}" />
                <DataGridTextColumn Header="Entry Time" Width="150"
                                   Binding="{Binding EntryTime, StringFormat=yyyy-MM-dd HH:mm}" />
                <DataGridTextColumn Header="Elapsed" Width="80"
                                   Binding="{Binding ElapsedTime}" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Close"
                Click="OnCloseClick"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Padding="16,8" />
    </Grid>
</Window>
