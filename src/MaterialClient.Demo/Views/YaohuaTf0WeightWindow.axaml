<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MaterialClient.Demo.Views.YaohuaTf0WeightWindow"
        Title="Yaohua tF=0 weight demo"
        Width="1100" Height="680"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.weight-label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>
        <Style Selector="TextBlock.weight-value">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
    </Window.Styles>

    <Grid Margin="24" ColumnDefinitions="*,16,320">
    <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
        <TextBlock Grid.Row="0"
                   Text="耀华 tF=0 重量对照（Demo）"
                   FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="未记皮重时皮重为 0。连续帧没有皮重字段，需要时点「记皮重」。串口固定 9600、8 数据位、无校验、1 停止位。"
                   FontSize="13" Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="端口" VerticalAlignment="Center" />
            <ComboBox x:Name="PortList" Width="160" />
            <Button Content="刷新" Click="OnRefreshPortsClick" />
            <Button Content="连接" Click="OnConnectClick" />
            <Button Content="断开" Click="OnDisconnectClick" />
        </StackPanel>

        <Grid Grid.Row="3" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
            <TextBox x:Name="HexInput"
                     Grid.Row="0" Grid.Column="0"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas,Courier New,monospace"
                     FontSize="14"
                     MinHeight="96"
                     Watermark="02 2D 30 30 30 31 33 30 32 31 44 03" />
            <Button Grid.Row="0" Grid.Column="1"
                    Content="载入"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Click="OnLoadClick" />

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                <Button Content="上一帧" Click="OnPreviousClick" />
                <Button Content="下一帧" Click="OnNextClick" />
                <TextBlock x:Name="FrameIndexText"
                           Text="frame 0/0"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
                <TextBlock x:Name="StatusText"
                           Text="not loaded"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           Margin="12,0,0,0" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="4" Columns="2" Margin="0,20,0,8">
            <StackPanel Margin="0,0,12,12">
                <TextBlock Classes="weight-label" Text="实时" />
                <TextBlock x:Name="LiveValueText" Classes="weight-value" Text="-" />
            </StackPanel>
            <StackPanel Margin="12,0,0,12">
                <TextBlock Classes="weight-label" Text="毛重" />
                <TextBlock x:Name="GrossValueText" Classes="weight-value" Text="-" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Classes="weight-label" Text="皮重" />
                <TextBlock x:Name="TareValueText" Classes="weight-value" Text="0" />
            </StackPanel>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Classes="weight-label" Text="净重" />
                <TextBlock x:Name="NetValueText" Classes="weight-value" Text="-" />
            </StackPanel>
        </UniformGrid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <Button Content="记毛重" Click="OnCaptureGrossClick" />
            <Button Content="记皮重" Click="OnCaptureTareClick" />
            <Button Content="清空" Click="OnClearClick" />
            <Button Content="采样去皮前" Click="OnSampleBeforeTareClick" />
            <Button Content="采样去皮后" Click="OnSampleAfterTareClick" />
        </StackPanel>
        <TextBlock Grid.Row="6"
                   x:Name="TareCheckLog"
                   Text="第10、11字节从1计。xor match 表示它们等于第2到第9字节的异或，不是独立 NET 标志。"
                   FontFamily="Consolas,Courier New,monospace"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0" />
    </Grid>

    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="不同帧（已去重）"
                   FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,8" />
        <TextBlock Grid.Row="1"
                   Text="相同结构只留一行。重量数字和校验变化不算新类型。出现第二行才表示设备还发了别的帧。"
                   FontSize="13" Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />
        <Border Grid.Row="2"
                MinHeight="240"
                BorderThickness="1"
                BorderBrush="#888"
                Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="KindLog"
                           Text="(none)"
                           FontFamily="Consolas,Courier New,monospace"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
        <Button Grid.Row="3"
                Content="清空记录"
                Margin="0,12,0,0"
                HorizontalAlignment="Left"
                Click="OnClearKindsClick" />
    </Grid>
    </Grid>
</Window>
