<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MaterialClient.Demo.Views.YaohuaTf1WeightWindow"
        Title="Yaohua tF=1 command demo"
        Width="760" Height="640"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="TextBlock.weight-label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>
        <Style Selector="TextBlock.weight-value">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
    </Window.Styles>

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="耀华 tF=1 指令查询（Demo）"
                   FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,8" />
        <TextBlock Grid.Row="1"
                   Text="仪表必须设为 tF=1，否则不接收命令。串口固定 9600、8 数据位、无校验、1 停止位。地址 01 对应 A。"
                   FontSize="13" Foreground="Gray"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="端口" VerticalAlignment="Center" />
            <ComboBox x:Name="PortList" Width="140" />
            <Button Content="刷新" Click="OnRefreshPortsClick" />
            <TextBlock Text="地址" VerticalAlignment="Center" />
            <ComboBox x:Name="AddressList" Width="72" />
            <Button Content="连接" Click="OnConnectClick" />
            <Button Content="断开" Click="OnDisconnectClick" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="握手" Click="OnHandshakeClick" />
            <Button Content="读毛重" Click="OnReadGrossClick" />
            <Button Content="读皮重" Click="OnReadTareClick" />
            <Button Content="读净重" Click="OnReadNetClick" />
            <Button Content="连续查询" Click="OnPollClick" />
            <Button Content="停止" Click="OnStopPollClick" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   x:Name="StatusText"
                   Text="closed"
                   FontFamily="Consolas,Courier New,monospace"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <UniformGrid Grid.Row="5" Columns="3" Margin="0,8,0,8">
            <StackPanel>
                <TextBlock Classes="weight-label" Text="毛重" />
                <TextBlock x:Name="GrossValueText" Classes="weight-value" Text="-" />
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="weight-label" Text="皮重" />
                <TextBlock x:Name="TareValueText" Classes="weight-value" Text="-" />
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="weight-label" Text="净重" />
                <TextBlock x:Name="NetValueText" Classes="weight-value" Text="-" />
            </StackPanel>
        </UniformGrid>

        <TextBox Grid.Row="6"
                 x:Name="HexLog"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Consolas,Courier New,monospace"
                 FontSize="13"
                 MinHeight="140"
                 Watermark="tx / rx" />
    </Grid>
</Window>
