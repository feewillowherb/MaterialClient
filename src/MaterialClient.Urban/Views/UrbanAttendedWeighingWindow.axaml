<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:entities="using:MaterialClient.Common.Entities"
        xmlns:viewModels="using:MaterialClient.Urban.ViewModels"
        xmlns:ui="using:MaterialClient.UI.Controls"
        x:Class="MaterialClient.Urban.Views.UrbanAttendedWeighingWindow"
        x:DataType="viewModels:UrbanAttendedWeighingViewModel"
        Title="凡东城管地磅系统"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="True"
        Icon="/Assets/fd-ico.ico"
        Background="{DynamicResource BackgroundGray}">
    <Grid>
        <ui:WeighingWindowBase x:Name="WeighingWindowBase"
                               TitleBarPointerPressed="TitleBar_OnPointerPressed"
                               MinimizeButtonClick="OnMinimizeButtonClick"
                               CloseButtonClick="OnCloseButtonClick"
                               DeviceStatuses="{Binding DeviceStatuses}"
                               StatusBarBackground="{DynamicResource BackgroundGray}"
                               StatusBarBorderBrush="#E5E7EB"
                               StatusBarPadding="16,0">
            <ui:WeighingWindowBase.LogoContent>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="32"
                            Height="32"
                            Background="White"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Opacity="0.9">
                        <TextBlock Text="凡"
                                   Foreground="{DynamicResource PrimaryBlue}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="凡东城管地磅系统"
                               Foreground="White"
                               FontWeight="Medium"
                               FontSize="14"
                               VerticalAlignment="Center"
                               FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                    <TextBlock Text="FINDONG MATERIAL SYSTEM"
                               Foreground="#B0C4DE"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0" />
                </StackPanel>
            </ui:WeighingWindowBase.LogoContent>

            <ui:WeighingWindowBase.MenuContent>
                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Classes="popup-menu-item-button" Content="系统设置" Click="OnSystemSettingsClick" />
                </StackPanel>
            </ui:WeighingWindowBase.MenuContent>

            <ui:WeighingWindowBase.WeightContent>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#4169E1" Offset="0" />
                            <GradientStop Color="#4A85F9" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="24,0">
                        <Border Width="256"
                                Height="48"
                                Background="#3D6BB3"
                                CornerRadius="4"
                                BorderBrush="#5A7FE6"
                                BorderThickness="1"
                                Opacity="0.6" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <TextBlock Text="{Binding CurrentWeight}"
                                       FontSize="48"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       FontFamily="Consolas, 'Liberation Mono', 'Courier New'"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="吨"
                                       FontSize="18"
                                       Foreground="#B0C4DE"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,8" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding WeightStatus}"
                                   Foreground="{Binding WeightStatusColor}"
                                   FontSize="18"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                    </Grid>
                </Border>
            </ui:WeighingWindowBase.WeightContent>

            <ui:WeighingWindowBase.ContentArea>
                <Grid ColumnDefinitions="*,360">
                    <Border Grid.Column="0" Classes="card-border" Margin="8,8,4,8">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <!-- Tab Bar -->
                            <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="tab-button active" Name="TabAll" Content="全部记录" Click="OnTabClick" />
                                    <Button Classes="tab-button" Name="TabNormal" Content="正常" Click="OnTabClick" />
                                    <Button Classes="tab-button" Name="TabAbnormal" Content="异常" Click="OnTabClick" />
                                </StackPanel>
                            </Border>

                        <!-- Filters -->
                            <Border Grid.Row="1" Margin="12,12,12,0"
                                    BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                                    Padding="0,0,0,12">
                                <StackPanel Spacing="8">
                                    <!-- Date Range -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="称重时间" FontSize="12" Foreground="#475569"
                                                   Width="56" VerticalAlignment="Center"
                                                   FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                        <TextBox Classes="filter-input" Width="130" />
                                        <TextBox Classes="filter-input" Width="130" />
                                    </StackPanel>
                                    <!-- License Plate Search -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="车牌号码" FontSize="12" Foreground="#475569"
                                                   Width="56" VerticalAlignment="Center"
                                                   FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                        <TextBox Classes="filter-input" Width="192" />
                                        <Button Classes="primary-button" Content="搜索" />
                                        <Button Classes="secondary-button" Content="重置" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        <!-- DataGrid Table Header Label -->
                            <Border Grid.Row="2" Background="{DynamicResource PrimaryBlue}" Padding="12,0">
                                <Grid ColumnDefinitions="100,140,80,80,*">
                                    <TextBlock Text="车牌" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                    <TextBlock Grid.Column="1" Text="称重时间" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                    <TextBlock Grid.Column="2" Text="重量" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                    <TextBlock Grid.Column="3" Text="状态" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                    <TextBlock Grid.Column="4" Text="操作" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                </Grid>
                            </Border>

                        <!-- Vehicle Records List (using Common.Entities.WeighingRecord) -->
                            <ItemsControl Grid.Row="3" Name="VehicleList" Margin="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="entities:WeighingRecord">
                                        <Border Background="Transparent"
                                                BorderBrush="#F1F5F9" BorderThickness="0,0,0,1"
                                                Padding="12,6"
                                                PointerPressed="OnRecordClick"
                                                Tag="{Binding}">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="Background" Value="#F0F7FF" />
                                                </Style>
                                            </Border.Styles>
                                            <Grid ColumnDefinitions="100,140,80,80,*">
                                                <TextBlock Text="{Binding PlateNumber}" FontSize="12" FontWeight="Medium"
                                                           Foreground="#333333" VerticalAlignment="Center"
                                                           FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                                <TextBlock Grid.Column="1" Text="{Binding AddDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="12"
                                                           Foreground="#666666" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding TotalWeight, StringFormat='{}{0:F2} 吨'}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="#333333" />
                                                <Panel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Border Background="#DCFCE7" CornerRadius="3" Padding="6,2">
                                                        <Border.IsVisible>
                                                            <MultiBinding>
                                                                <Binding Path="SyncStatus" />
                                                            </MultiBinding>
                                                        </Border.IsVisible>
                                                        <TextBlock Text="正常" FontSize="11" Foreground="#15803D"
                                                                   FontWeight="Medium"
                                                                   FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                                    </Border>
                                                </Panel>
                                                <Button Grid.Column="4" Classes="primary-button" Content="审批"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        <!-- Pagination Footer -->
                            <Border Grid.Row="4" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                                    Padding="12,0">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center" Height="32">
                                    <TextBlock Grid.Column="0" FontSize="11"
                                               Foreground="#666666" VerticalAlignment="Center"
                                               FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}共 {0} 条  第 {1} / {2} 页">
                                                <Binding Path="TotalCount" />
                                                <Binding Path="CurrentPage" />
                                                <Binding Path="TotalPages" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="secondary-button" Content="上一页"
                                                FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                        <Button Classes="secondary-button" Content="下一页"
                                                FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                <!-- Right Sidebar: Photos (360px) -->
                    <Border Grid.Column="1" Classes="section-border" Margin="4,8,8,8">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource PrimaryBlue}" Height="36" CornerRadius="8,8,0,0">
                                <TextBlock Text="照片" Foreground="White" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="Medium"
                                           FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                            </Border>

                            <ScrollViewer Grid.Row="1">
                                <StackPanel Margin="8" Spacing="8">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="车牌识别抓拍" FontSize="11" Foreground="#666666"
                                                       FontWeight="Medium" VerticalAlignment="Center"
                                                       FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                            <TextBlock Grid.Column="1" Text="{Binding LprPhotoTime}" FontSize="11" Foreground="#94A3B8"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="120" Background="#E5E7EB" CornerRadius="4"
                                                BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True">
                                            <Image Source="{Binding LprPhotoPath, Converter={StaticResource CarNullOrEmptyImageConverter}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="摄像头抓拍" FontSize="11" Foreground="#666666"
                                                       FontWeight="Medium" VerticalAlignment="Center"
                                                       FontFamily="'Microsoft YaHei UI', 'SimHei', 'Noto Sans CJK SC', Inter" />
                                            <TextBlock Grid.Column="1" Text="{Binding CameraPhotoTime}" FontSize="11" Foreground="#94A3B8"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <Border Height="120" Background="#E5E7EB" CornerRadius="4"
                                                BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True">
                                            <Image Source="{Binding CameraPhotoPath, Converter={StaticResource CarNullOrEmptyImageConverter}}"
                                                   Stretch="UniformToFill" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </ui:WeighingWindowBase.ContentArea>
        </ui:WeighingWindowBase>
    </Grid>
</Window>
