<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MaterialClient.Urban.Views.Dialogs.UnauthorizedNoticeWindow"
        Title="软件未授权"
        Width="480"
        Height="280"
        MinWidth="400"
        MinHeight="240"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="BorderOnly"
        Icon="/Assets/fd-ico.ico">

    <Grid RowDefinitions="*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="软件未授权"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#DC2626"
                       HorizontalAlignment="Center" />
            <TextBlock Text="请联系管理员获取授权文件（license.urban），并将其放置于程序目录后重新启动。"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#374151"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock x:Name="DetailTextBlock"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       IsVisible="False" />
        </StackPanel>

        <Button Grid.Row="1"
                Content="确定"
                HorizontalAlignment="Center"
                MinWidth="120"
                Margin="0,16,0,0"
                Click="OnConfirmClick" />
    </Grid>
</Window>
