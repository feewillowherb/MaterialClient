<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MaterialClient.Urban.Views.Dialogs.UnauthorizedNoticeWindow"
        Title="软件未授权"
        Width="480"
        Height="300"
        MinWidth="400"
        MinHeight="260"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="BorderOnly"
        Icon="/Assets/fd-ico.ico">

    <Grid RowDefinitions="*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="软件未授权"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#DC2626"
                       HorizontalAlignment="Center" />
            <TextBlock Text="请使用在线激活，或联系管理员获取授权文件（license.urban）并放置于程序目录后重新启动。"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#374151"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            <TextBlock x:Name="DetailTextBlock"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       IsVisible="False" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="0,16,0,0">
            <Button Content="在线激活"
                    MinWidth="120"
                    Click="OnOnlineActivateClick" />
            <Button Content="退出"
                    MinWidth="120"
                    Click="OnExitClick" />
        </StackPanel>
    </Grid>
</Window>
