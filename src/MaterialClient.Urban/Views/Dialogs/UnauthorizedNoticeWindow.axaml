<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MaterialClient.Urban.Views.Dialogs.UnauthorizedNoticeWindow"
        Title="软件未授权"
        Width="480"
        Height="300"
        MinWidth="400"
        MinHeight="260"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="BorderOnly"
        Icon="/Assets/fd-ico.ico">

    <Grid RowDefinitions="*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="软件未授权"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#DC2626"
                       HorizontalAlignment="Center" />
            <TextBlock Text="请联系运营获取接入码，点击下方在线激活。"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="#374151"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />

            <!-- 本机机器码（在线激活所需：提交给运营以获取接入码）。离线 license.urban 导入入口已移除（V2）。 -->
            <StackPanel Spacing="4"
                        Margin="0,4,0,0">
                <TextBlock Text="本机机器码"
                           FontSize="13"
                           Foreground="#6B7280" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="MachineCodeTextBox"
                             Grid.Column="0"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             TextWrapping="Wrap" />
                    <Button x:Name="CopyMachineCodeButton"
                            Grid.Column="1"
                            Content="复制"
                            MinWidth="72"
                            VerticalAlignment="Center"
                            Click="OnCopyMachineCodeClick" />
                </Grid>
            </StackPanel>

            <TextBlock x:Name="DetailTextBlock"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       IsVisible="False" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="0,16,0,0">
            <Button Content="在线激活"
                    MinWidth="120"
                    Classes="primary-button"
                    Click="OnOnlineActivateClick" />
            <Button Content="退出"
                    MinWidth="120"
                    Click="OnExitClick" />
        </StackPanel>
    </Grid>
</Window>
