<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MaterialClient.Common.EntityFrameworkCore</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Description>Kernel EF Core DbContext and migrations for MaterialClient</Description>
    <IsPublishable>false</IsPublishable>
    <PublishSingleFile Condition="'$(OutputType)' != 'Exe' And '$(OutputType)' != 'WinExe'">false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MaterialClient.Common\MaterialClient.Common.csproj" />
  </ItemGroup>

</Project>
