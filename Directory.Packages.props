<Project>
  <!--
    Directory.Packages.props enables Central Package Management (CPM).
    All package versions are defined here, and projects reference packages without version numbers.
    This ensures version consistency across all projects and simplifies version updates.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Source Generators -->
    <PackageVersion Include="AutoConstructor" Version="5.6.0" />
    <!-- Core Framework Packages -->
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.0-beta3" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
    <!-- Entity Framework Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1" />
    <!-- HTTP Client -->
    <PackageVersion Include="Refit.HttpClientFactory" Version="9.0.2" />
    <!-- Volo ABP Framework -->
    <PackageVersion Include="Volo.Abp.Autofac" Version="10.0.1" />
    <PackageVersion Include="Volo.Abp.Core" Version="10.0.1" />
    <PackageVersion Include="Volo.Abp.Ddd.Domain" Version="10.0.1" />
    <PackageVersion Include="Volo.Abp.Ddd.Application.Contracts" Version="10.0.1" />
    <PackageVersion Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="10.0.1" />
    <PackageVersion Include="Volo.Abp.Data" Version="10.3.0" />
    <PackageVersion Include="Volo.Abp.TestBase" Version="10.0.1" />
    <PackageVersion Include="Volo.Abp.Authorization" Version="10.0.1" />
    <PackageVersion Include="Volo.Abp.BackgroundJobs.Abstractions" Version="10.0.1" />
    <!-- System Packages -->
    <PackageVersion Include="System.Management" Version="10.0.1" />
    <PackageVersion Include="System.IO.Ports" Version="10.0.1" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0-preview.1" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.0-preview.1.25080.3" />
    <!-- Reactive Extensions -->
    <PackageVersion Include="ReactiveUI" Version="20.1.1" />
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="2.5.1" />
    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="8.0.0-dev-02318" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Avalonia UI -->
    <PackageVersion Include="Avalonia" Version="11.3.9" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="11.3.8" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.9" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.9" />
    <PackageVersion Include="Irihi.Avalonia.Shared" Version="0.3.1" />
    <PackageVersion Include="Irihi.Ursa" Version="1.14.0" />
    <PackageVersion Include="Irihi.Ursa.Themes.Semi" Version="1.14.0" />
    <PackageVersion Include="MessageBox.Avalonia" Version="3.3.1.1" />
    <PackageVersion Include="Semi.Avalonia" Version="11.3.7.1" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Reqnroll.xUnit" Version="3.2.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.16" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!-- Utilities -->
    <PackageVersion Include="Yitter.IdGenerator" Version="1.0.14" />
    <PackageVersion Include="FlashCap" Version="1.11.0" />
    <PackageVersion Include="Aliyun.OSS.SDK.NetCore" Version="2.14.1" />
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
    <PackageVersion Include="Magicodes.IE.Csv" Version="2.8.2" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageVersion Include="SQLitePCLRaw.bundle_zetetic" Version="2.1.11" />
  </ItemGroup>
</Project>